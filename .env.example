# Plantilla de variables de entorno. Copia este archivo como .env y completa
# los valores. NO subas el .env real a git.

# Frontend (expuestas al navegador — la anon key es pública por diseño)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Solo para Netlify Functions (NUNCA con prefijo VITE_, NUNCA en el navegador)
# En producción se configuran en Netlify → Site settings → Environment variables.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=DAIG
